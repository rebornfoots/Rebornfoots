# Configure these as server-level environment variables. Do not commit real values.
F2H_DB_HOST=localhost
F2H_DB_NAME=inbornfood
F2H_DB_USER=inbornfood_app
F2H_DB_PASSWORD=replace-with-a-strong-password
F2H_RAZORPAY_KEY_ID=
F2H_RAZORPAY_KEY_SECRET=
F2H_RAZORPAY_WEBHOOK_SECRET=
F2H_TELEGRAM_BOT_TOKEN=
F2H_TELEGRAM_CHAT_ID=
F2H_ADMIN_USERNAME=admin
# Generate with: php -r "echo password_hash('replace-with-a-strong-password', PASSWORD_DEFAULT), PHP_EOL;"
F2H_ADMIN_PASSWORD_HASH=replace-with-a-password-hash
